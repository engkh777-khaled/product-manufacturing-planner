# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
APP_ENV=development

# mock = in-memory fictional data (default) | supabase = Supabase-backed repository (from M06)
DATA_BACKEND=mock

# supabase = real sign-in (default) | disabled = fictional demo planner, only allowed in development/test
AUTH_MODE=supabase

# Supabase dev project: Dashboard → Project Settings → API / API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secrets. Leave empty until a milestone needs them.
# SUPABASE_SECRET_KEY=sb_secret_...            # bypasses RLS — never expose to the browser (needed from M06)
# Session pooler string from Dashboard → Connect. Percent-encode special characters in the password.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Shared password of the fictional demo users. Leave empty: scripts/seed_demo_users.py generates one.
# DEMO_USER_PASSWORD=
