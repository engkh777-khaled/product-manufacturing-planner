# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
APP_ENV=development

# mock = in-memory fictional data (default) | supabase = Supabase-backed repository (from M06)
DATA_BACKEND=mock

# Supabase dev project: Dashboard → Project Settings → API / API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secrets. Leave empty until a milestone needs them.
# SUPABASE_SECRET_KEY=sb_secret_...            # bypasses RLS — never expose to the browser (needed from M06)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres   # M04/M08
